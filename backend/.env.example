# Gemini API key — add your real key here and rename this file to .env
GEMINI_API_KEY=your_gemini_api_key_here

# Automatically populated by index_knowledge.py after the File Search store is created.
GEMINI_FILE_SEARCH_STORE_NAME=

WEBSITE_URL=https://thekaushikdas.com
CV_PATH=./knowledge_base/cv_kaushik_pm.pdf

# Current model used by the RAG service.
GEMINI_MODEL=gemini-3.8-flash

# FastAPI settings
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=https://thekaushikdas.com,http://localhost:5173
